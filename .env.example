# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha. NUNCA versione o `.env`.
#
# Só entram aqui chaves PÚBLICAS (o Vite embute tudo que começa com VITE_ no
# bundle que vai para o navegador). Chaves de gateway e a service_role ficam
# nos secrets das Edge Functions — veja o bloco no fim do arquivo.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Notificações push. Gere um par VAPID com:
#   npx web-push generate-vapid-keys
# A PÚBLICA vai aqui; a PRIVADA vai nos secrets da Edge Function (abaixo).
# Sem esta chave o app pede permissão mas não registra o aparelho — ou seja,
# nenhum aviso chega com o app fechado.
VITE_VAPID_PUBLIC_KEY=


# ===========================================================================
# NÃO coloque as chaves abaixo neste arquivo — elas são secrets do servidor.
# Cadastre com a CLI do Supabase:
#
#   --- Pix (InfinitePay) --------------------------------------------------
#   supabase secrets set INFINITEPAY_HANDLE=seu_handle
#
#   --- Asaas (opcional) ---------------------------------------------------
#   supabase secrets set ASAAS_API_KEY=$aact_...
#   supabase secrets set ASAAS_WEBHOOK_TOKEN=um_token_longo_e_aleatorio
#   supabase secrets set ASAAS_ENV=sandbox
#
#   --- Mercado Pago (cartão de crédito) -----------------------------------
#   Painel do MP → Suas integrações → sua aplicação → Credenciais
#   supabase secrets set MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
#   # Segredo do webhook: Suas integrações → Webhooks → Configurar notificações
#   supabase secrets set MERCADOPAGO_WEBHOOK_SECRET=...
#
#   --- PagBank (cartão de débito) -----------------------------------------
#   Painel do PagBank → Venda online → Integrações → Token
#   supabase secrets set PAGBANK_TOKEN=...
#   supabase secrets set PAGBANK_ENV=sandbox       # production no go-live
#
#   --- Notificações push --------------------------------------------------
#   supabase secrets set VAPID_PUBLIC_KEY=<a mesma do VITE_VAPID_PUBLIC_KEY>
#   supabase secrets set VAPID_PRIVATE_KEY=<a privada do web-push>
#   supabase secrets set VAPID_SUBJECT=mailto:contato@sushiart.com.br
#   # Segredo que o BANCO usa para chamar a função send-push. Invente um longo.
#   # O mesmo valor vai em private.app_config (veja 0007_push.sql).
#   supabase secrets set PUSH_HOOK_SECRET=um-token-longo-e-aleatorio
#
#   --- Geral --------------------------------------------------------------
#   supabase secrets set APP_ORIGIN=https://pedido.sushiart.com.br
#
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já existem
# automaticamente dentro das Edge Functions — não precisa cadastrar.
# ===========================================================================

# Endereco do painel do restaurante, sem a barra. Vazio = /admin.
#
# Trocar por um codigo tira o painel do radar dos robos, que varrem /admin,
# /wp-admin e afins o dia inteiro. NAO e segredo nem senha: por ter prefixo
# VITE_, vai compilado no JavaScript do navegador, e chegar na tela de entrada
# nao entra em nada. Quem barra a entrada continua sendo o login mais a tabela
# de equipe, no servidor.
#
# Mudou aqui? Mude tambem o segredo ADMIN_PATH das Edge Functions, senao o
# aviso de pedido novo e o retorno do Mercado Pago apontam para o lugar errado.
VITE_ADMIN_PATH=

# ---------------------------------------------------------------------------
# Analytics. Vazias = o app NAO baixa script de terceiro nenhum.
# Ver docs/ANALYTICS.md.
# ---------------------------------------------------------------------------
VITE_META_PIXEL_ID=
VITE_GA_MEASUREMENT_ID=
# true liga os logs de evento fora de desenvolvimento
VITE_ANALYTICS_DEBUG=

# O token da Conversions API NAO vem aqui: ele vive nos segredos das Edge
# Functions (META_CAPI_TOKEN e META_PIXEL_ID). Com ele no navegador, qualquer
# um manda evento falso para a conta de anuncios do restaurante.
